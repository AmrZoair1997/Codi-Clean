#!/bin/sh
# Codi Clean launcher: `codi` opens the menu, `codi <command>` runs one directly.
set -eu
codi_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' 'Codi needs Python 3. Install it, then run codi again.' >&2
    exit 1
fi
# -I: ignore PYTHON* variables and user site-packages, so only Codi's own code loads.
exec python3 -I "$codi_dir/codi.py" "$@"
